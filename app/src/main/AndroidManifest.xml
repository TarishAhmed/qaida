<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No network permissions of any kind. app/build.gradle.kts fails the build on anything not allowlisted. -->

    <!-- Requested only when the learner first taps record; everything else works without it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The optional daily reminder: off by default, asked for only when the learner turns it on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms are cleared on reboot; this puts the reminder back. Install-time, no prompt. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Added by media3 for streaming bandwidth estimates; this app only plays bundled clips. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".QaidaApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Qaida">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
